DB_USER=seu_usuario_aqui
DB_PASS=sua_senha_aqui
RABBITMQ_USER=admin_aqui
RABBITMQ_PASS=senha_aqui
WUZAPI_ADMIN_TOKEN=token_administrativo_aqui
AUTHENTICATION_API_KEY=token_da_instancia_aqui
# Use a mesma chave nos dois lados; mínimo de 32 caracteres.
WUZAPI_HMAC_KEY=chave_hmac_wuzapi_com_32_caracteres_aqui
# Exatamente 32 caracteres; protege configurações persistidas da WuzAPI.
WUZAPI_GLOBAL_ENCRYPTION_KEY=chave_interna_wuzapi_de_32_chars
WUZAPI_BASE_URL=http://wuzapi:8080
OPENAI_API_KEY=chave_openai_aqui
# Gere uma vez com: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=chave_base64_de_32_bytes_aqui
# Chave compartilhada apenas entre os serviços internos; use no mínimo 32 caracteres.
FINANCIAL_SERVICE_API_KEY=chave_interna_financeiro_com_32_caracteres
