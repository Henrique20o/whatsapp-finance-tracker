DB_USER=seu_usuario_aqui
DB_PASS=sua_senha_aqui
RABBITMQ_USER=admin_aqui
RABBITMQ_PASS=senha_aqui
WUZAPI_ADMIN_TOKEN=token_administrativo_aqui
AUTHENTICATION_API_KEY=token_da_instancia_aqui
# Use a mesma chave nos dois lados; mínimo de 32 caracteres.
WUZAPI_HMAC_KEY=chave_hmac_wuzapi_com_32_caracteres_aqui
# Exatamente 32 caracteres; protege configurações persistidas da WuzAPI.
WUZAPI_GLOBAL_ENCRYPTION_KEY=chave_interna_wuzapi_de_32_chars
WUZAPI_BASE_URL=http://wuzapi:8080
OPENAI_API_KEY=chave_openai_aqui
# Gere uma vez com: openssl rand -base64 32
PHONE_ENCRYPTION_KEY=chave_base64_de_32_bytes_aqui
# Chave compartilhada apenas entre os serviços internos; use no mínimo 32 caracteres.
FINANCIAL_SERVICE_API_KEY=chave_interna_financeiro_com_32_caracteres
# Diretório local com mobile-jwt-private.pem (PKCS#8) e mobile-jwt-public.pem (X.509).
# Gere as chaves seguindo docs/security/mobile-jwt-configuration.md e nunca as versione.
MOBILE_JWT_KEYS_DIR=./secrets
MOBILE_JWT_ISSUER=https://api.whatsapp-finance-tracker.local
MOBILE_JWT_AUDIENCE=finance-tracker-mobile
MOBILE_JWT_ACCESS_TOKEN_TTL=15m
MOBILE_REFRESH_TOKEN_INACTIVITY=30d
MOBILE_SESSION_ABSOLUTE_TTL=90d
# Chave Base64 de pelo menos 32 bytes para HMAC de códigos e IPs mobile.
# No PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
MOBILE_AUTH_HMAC_KEY=chave_base64_de_32_bytes_aqui
# Chave Base64 de exatamente 32 bytes, exclusiva da entrega do código.
# No Windows PowerShell 5.1:
# $rng = [Security.Cryptography.RandomNumberGenerator]::Create(); $bytes = New-Object byte[] 32; $rng.GetBytes($bytes); [Convert]::ToBase64String($bytes); $rng.Dispose()
MOBILE_AUTH_DELIVERY_KEY=outra_chave_base64_de_32_bytes_aqui
MOBILE_AUTH_DELIVERY_KEY_ID=v1
MOBILE_VERIFICATION_CODE_TTL=5m
MOBILE_VERIFICATION_RESEND_INTERVAL=60s
